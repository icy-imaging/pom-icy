                    <url>https://nexus-icy.pasteur.cloud/repository/icy-core-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>-->
        </profile>

        <profile>
            <id>icy-extension</id>
            <activation>
                <file>
                    <missing>${project.basedir}/.kernel</missing>
                </file>
            </activation>

            <build>
                <defaultGoal>clean install</defaultGoal>

                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>icy-enforcer</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <validateVersion implementation="fr.icy.maven.plugin.enforcer.ValidateVersion"/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>fr.icy.maven</groupId>
                        <artifactId>mojo-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-properties</id>
                                <goals>
                                    <goal>generate-extension-properties</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>install-extension</id>
                                <goals>
                                    <goal>install-extension</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-extension-data</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/META-INF/data/</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}</directory>
                                            <includes>
                                                <include>icon.png</include>
                                                <include>icon.svg</include>
                                                <include>CHANGELOG.md</include>
                                                <include>README.md</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>copy-icons-dir</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/META-INF/icons/</outputDirectory>
                                    <filters>
                                        <filter>

                                        </filter>
                                    </filters>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/icons/</directory>
                                            <includes>
                                                <include>**/*.svg</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>

            <!-- Required dependencies -->
            <dependencies>
                <dependency>
                    <groupId>fr.icy</groupId>
                    <artifactId>icy</artifactId>
                    <version>${icy.version}</version>
                </dependency>
            </dependencies>

