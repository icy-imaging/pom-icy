    <!-- default build -->
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <defaultGoal>clean install</defaultGoal>

        <!-- List of pre-configured Maven plugins -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <release>17</release>
                    </configuration>
                    <executions>
                        <execution>
                            <id>default-compile</id>
                            <configuration>
                                <source>17</source>
                                <target>17</target>
                                <release>17</release>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <outputDirectory>${outputDirectory}</outputDirectory>
                        <archive>
                            <addMavenDescriptor>${maven-jar-plugin.includeMavenDescriptor}</addMavenDescriptor>
                            <manifestEntries>
                                <Multi-Release>true</Multi-Release>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <configuration>
                        <outputDirectory>${outputDirectory}</outputDirectory>
                        <includePom>${maven-source-plugin.includePom}</includePom>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <outputDirectory>${outputDirectory}/javadoc</outputDirectory>
                        <!-- disable javadoc errors (we definitely do not consider them as severe) -->
                        <additionalOptions>
                            <additionalOption>-Xdoclint:none</additionalOption>
                        </additionalOptions>
                        <failOnError>false</failOnError>
                        <detectJavaApiLink>false</detectJavaApiLink>
                        <legacyMode>true</legacyMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadoc</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>fr.icy.maven</groupId>
                            <artifactId>enforcer-maven-plugin</artifactId>
                            <version>${icy.maven.plugin.enforcer.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>fr.icy.maven</groupId>
                    <artifactId>mojo-maven-plugin</artifactId>
                    <version>${icy.maven.plugin.mojo.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- POM profiles -->
    <profiles>
        <profile>
            <id>icy-kernel</id>
            <activation>
                <file>
                    <exists>${project.basedir}/.kernel</exists>
                </file>
            </activation>

            <build>
                <defaultGoal>clean install</defaultGoal>
            </build>

